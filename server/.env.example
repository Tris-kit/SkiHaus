# --- Database (Turso / libSQL, via the Vercel integration) ---
TURSO_DATABASE_URL=libsql://your-db.turso.io
TURSO_AUTH_TOKEN=xxxx

# --- Transactional email (Resend) --- REQUIRED IN PRODUCTION
# Registration confirms the address by email, so with this unset nobody can
# finish signing up. Unset is fine locally: the link is printed to the server
# console instead. /api/health reports mail:false either way.
RESEND_API_KEY=re_xxxx
MAIL_FROM="SkiHaus <hello@example.com>"

# Note: there is deliberately no SESSION_SECRET. Session and link tokens are
# 256 random bits stored as SHA-256 hashes (server/lib/ids.ts), so there is
# nothing to sign and no secret to rotate.

# --- Public base URL (optional) ---
# Absolute origin used to build confirmation, reset and guest links. Falls back to the
# request host, which is correct on Vercel preview deployments.
# NEXT_PUBLIC_BASE_URL=https://skihaus.example.com
