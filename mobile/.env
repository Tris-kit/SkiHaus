# Which backend this build talks to. Metro inlines EXPO_PUBLIC_* at BUILD time,
# so changing this needs a rebuild, not a reload.
#
# Committed on purpose: it holds only a public URL. Local overrides go in
# .env.local, which is gitignored.
#
# TODO: set to the production domain once one is registered.
EXPO_PUBLIC_API_BASE=http://localhost:3000
