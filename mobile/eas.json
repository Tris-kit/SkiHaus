{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": { "simulator": true },
      "env": { "EXPO_PUBLIC_API_BASE": "https://REPLACE-WITH-DEV-BRANCH-URL" }
    },
    "preview": {
      "distribution": "internal",
      "ios": { "simulator": false },
      "env": { "EXPO_PUBLIC_API_BASE": "https://REPLACE-WITH-DEV-BRANCH-URL" }
    },
    "simulator": {
      "distribution": "internal",
      "ios": { "simulator": true },
      "env": { "EXPO_PUBLIC_API_BASE": "https://REPLACE-WITH-PROD-DOMAIN" }
    },
    "production": {
      "autoIncrement": true,
      "env": { "EXPO_PUBLIC_API_BASE": "https://REPLACE-WITH-PROD-DOMAIN" }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "appleId": "tschwichow@gmail.com",
        "appleTeamId": "G327UPP4LL",
        "ascAppId": "REPLACE-WITH-APP-STORE-CONNECT-APP-ID"
      }
    }
  }
}
